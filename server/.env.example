# Copy this file to .env and fill in real values.
# .env is ignored by Git; this example file is committed so others know what's needed.

# Port the API listens on during development
PORT=4000

# development | production | test
NODE_ENV=development

# MongoDB Atlas connection string: Atlas → Database → Connect → Drivers.
# Replace USERNAME, PASSWORD and CLUSTER. Keep "/littlehello" as the database name.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/littlehello?retryWrites=true&w=majority

# (Coming soon) SESSION_SECRET, CLIENT_ORIGIN