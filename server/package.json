{
  "name": "littlehello-server",
  "version": "0.1.0",
  "description": "LittleHello API — small hellos, real friendships.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "try:user": "node --env-file=.env scripts/try-user-model.js",
    "try:profile": "node --env-file=.env scripts/try-profile-model.js",
    "try:validation": "node scripts/try-validation.js",
    "try:ratelimit": "node scripts/try-rate-limit.js",
    "demo:clean": "node --env-file=.env scripts/cleanup-demo-users.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "zod": "^4.6.7"
  }
}
